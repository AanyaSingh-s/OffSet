      "html": "<link data-kid=\"1\" data-name=\"google fonts stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n.scope{--bg:#f3f5f3;--surface:#ffffff;--card:#ffffff;--border:#e2e6e3;--border-strong:#cfd6d1;--text:#0d1512;--text-2:#55635d;--text-3:#879189;--accent:#047857;--brand:#059669;--on-brand:#ffffff;--accent-weak:#e6f4ee;--success:#047857;--success-weak:#e6f4ee;--warning:#b45309;--warning-weak:#fbf1e0;--danger:#dc2626;--danger-weak:#fbeaea;}\n.scope input::placeholder{color:var(--text-3)}\n</style>\n<div class=\"scope\" data-kid=\"2\" data-name=\"app layout container\" style=\"width:375px;min-height:812px;background:var(--bg);color:var(--text);font-family:'Plus Jakarta Sans',sans-serif;display:flex;flex-direction:column\">\n    <div data-kid=\"2-1\" data-name=\"main content wrapper\" style=\"flex:1;display:flex;flex-direction:column;justify-content:center;padding:32px 24px\">\n        <div data-kid=\"2-1-1\" data-name=\"header section\" style=\"text-align:center;margin-bottom:30px\">\n            <div data-kid=\"2-1-1-1\" data-name=\"brand logo icon container\" style=\"width:62px;height:62px;background:var(--brand);display:inline-flex;align-items:center;justify-content:center;margin-bottom:16px\">\n                <svg data-kid=\"2-1-1-1-1\" data-name=\"geometric block icon\" fill=\"none\" height=\"34\" viewbox=\"0 0 24 24\" width=\"34\">\n                    <rect height=\"12\" stroke=\"#fff\" stroke-width=\"2.2\" width=\"12\" x=\"3.5\" y=\"3.5\">\n                    </rect>\n                    <rect fill=\"#fff\" height=\"11\" width=\"11\" x=\"9.5\" y=\"9.5\">\n                    </rect>\n                </svg>\n            </div>\n            <h1 data-kid=\"2-1-1-2\" data-name=\"application title\" style=\"font-size:28px;font-weight:800;letter-spacing:-0.6px\">\n                OffSet\n            </h1>\n            <p data-kid=\"2-1-1-3\" data-name=\"application subtitle\" style=\"color:var(--text-2);font-size:13px;margin-top:6px\">\n                Offline-First Payment Mesh\n            </p>\n        </div>\n        <div data-kid=\"2-1-2\" data-name=\"authentication form container\" style=\"background:var(--card);border:1px solid var(--border);padding:22px\">\n            <div data-kid=\"2-1-2-1\" data-name=\"username input field group\" style=\"margin-bottom:16px\">\n                <label data-kid=\"2-1-2-1-1\" data-name=\"username label\" style=\"display:block;font-size:11px;font-weight:700;color:var(--text-2);margin-bottom:7px;text-transform:uppercase;letter-spacing:0.6px\">\n                    Username or VPA\n                </label>\n                <input data-kid=\"2-1-2-1-2\" data-name=\"username input field\" style=\"width:100%;height:46px;padding:0 14px;background:var(--bg);border:1px solid var(--border-strong);color:var(--text);font-size:15px;font-family:inherit;outline:none\" value=\"alice\"/>\n            </div>\n            <div data-kid=\"2-1-2-2\" data-name=\"password input field group\" style=\"margin-bottom:22px\">\n                <label data-kid=\"2-1-2-2-1\" data-name=\"password label\" style=\"display:block;font-size:11px;font-weight:700;color:var(--text-2);margin-bottom:7px;text-transform:uppercase;letter-spacing:0.6px\">\n                    Password\n                </label>\n                <input data-kid=\"2-1-2-2-2\" data-name=\"password input field\" style=\"width:100%;height:46px;padding:0 14px;background:var(--bg);border:1px solid var(--border-strong);color:var(--text);font-size:15px;font-family:inherit;outline:none\" type=\"password\" value=\"password123\"/>\n            </div>\n            <button data-kid=\"2-1-2-3\" data-name=\"sign in action button\" style=\"width:100%;height:48px;background:var(--brand);color:var(--on-brand);border:none;font-size:15px;font-weight:700;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px;cursor:pointer\">\n                <span data-kid=\"2-1-2-3-1\" data-name=\"sign in button label\">\n                    Sign In\n                </span>\n                <i class=\"ph ph-arrow-right\" data-kid=\"2-1-2-3-2\" data-name=\"arrow right icon\" style=\"font-size:18px\">\n                </i>\n            </button>\n            <div data-kid=\"2-1-2-4\" data-name=\"demo accounts section\" style=\"margin-top:22px;padding-top:18px;border-top:1px solid var(--border)\">\n                <div data-kid=\"2-1-2-4-1\" data-name=\"demo accounts helper text\" style=\"font-size:11px;color:var(--text-3);text-align:center;margin-bottom:10px\">\n                    Quick fill demo accounts (password123)\n                </div>\n                <div data-kid=\"2-1-2-4-2\" data-name=\"demo account buttons container\" style=\"display:flex;gap:8px\">\n                    <button data-kid=\"2-1-2-4-2-1\" data-name=\"alice demo login button\" style=\"flex:1;height:38px;background:var(--accent-weak);border:1px solid var(--brand);color:var(--accent);font-weight:700;font-size:13px;font-family:inherit;cursor:pointer\">\n                        Alice\n                    </button>\n                    <button data-kid=\"2-1-2-4-2-2\" data-name=\"bob demo login button\" style=\"flex:1;height:38px;background:var(--surface);border:1px solid var(--border);color:var(--text-2);font-weight:700;font-size:13px;font-family:inherit;cursor:pointer\">\n                        Bob\n                    </button>\n                    <button data-kid=\"2-1-2-4-2-3\" data-name=\"carol demo login button\" style=\"flex:1;height:38px;background:var(--surface);border:1px solid var(--border);color:var(--text-2);font-weight:700;font-size:13px;font-family:inherit;cursor:pointer\">\n                        Carol\n                    </button>\n                </div>\n            </div>\n        </div>\n        <div data-kid=\"2-1-3\" data-name=\"security footer\" style=\"text-align:center;margin-top:22px;font-size:11px;color:var(--text-3);display:flex;align-items:center;justify-content:center;gap:6px\">\n            <i class=\"ph ph-shield-check\" data-kid=\"2-1-3-1\" data-name=\"shield check icon\" style=\"font-size:15px;color:var(--accent)\">\n            </i>\n            <span data-kid=\"2-1-3-2\" data-name=\"security information text\">\n                End-to-End Hybrid Cryptography\n            </span>\n        </div>\n    </div>\n</div>\n",

      "html": "<link data-kid=\"1\" data-name=\"google fonts stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n.scope{--bg:#f3f5f3;--surface:#ffffff;--card:#ffffff;--border:#e2e6e3;--border-strong:#cfd6d1;--text:#0d1512;--text-2:#55635d;--text-3:#879189;--accent:#047857;--brand:#059669;--on-brand:#ffffff;--accent-weak:#e6f4ee;--success:#047857;--success-weak:#e6f4ee;--warning:#b45309;--warning-weak:#fbf1e0;--danger:#dc2626;--danger-weak:#fbeaea;}\n</style>\n<div class=\"scope\" data-kid=\"2\" data-name=\"app layout container\" style=\"width:375px;min-height:812px;background:var(--bg);color:var(--text);font-family:'Plus Jakarta Sans',sans-serif;display:flex;flex-direction:column\">\n    <header data-kid=\"2-1\" data-name=\"app header\" style=\"display:flex;align-items:center;justify-content:space-between;padding:15px 20px;border-bottom:1px solid var(--border);background:var(--surface)\">\n        <div data-kid=\"2-1-1\" data-name=\"brand identity container\" style=\"display:flex;align-items:center;gap:10px\">\n            <div data-kid=\"2-1-1-1\" data-name=\"logo icon background\" style=\"width:34px;height:34px;background:var(--brand);display:flex;align-items:center;justify-content:center\">\n                <svg data-kid=\"2-1-1-1-1\" data-name=\"brand square logo icon\" fill=\"none\" height=\"20\" viewbox=\"0 0 24 24\" width=\"20\">\n                    <rect height=\"12\" stroke=\"#fff\" stroke-width=\"2\" width=\"12\" x=\"3.5\" y=\"3.5\">\n                    </rect>\n                    <rect fill=\"#fff\" height=\"11\" width=\"11\" x=\"9.5\" y=\"9.5\">\n                    </rect>\n                </svg>\n            </div>\n            <div data-kid=\"2-1-1-2\" data-name=\"brand name and subtitle\">\n                <div data-kid=\"2-1-1-2-1\" data-name=\"brand name\" style=\"font-size:15px;font-weight:800;letter-spacing:-0.3px;line-height:1.1\">\n                    OffSet\n                </div>\n                <div data-kid=\"2-1-1-2-2\" data-name=\"brand subtitle\" style=\"font-size:9px;color:var(--text-3);font-weight:700;text-transform:uppercase;letter-spacing:1.2px\">\n                    Offline Mesh\n                </div>\n            </div>\n        </div>\n        <div data-kid=\"2-1-2\" data-name=\"connection status badge\" style=\"display:inline-flex;align-items:center;gap:6px;padding:5px 10px;background:var(--success-weak);border:1px solid var(--success);color:var(--success);font-size:11px;font-weight:700\">\n            <i class=\"ph ph-wifi-high\" data-kid=\"2-1-2-1\" data-name=\"wifi high signal icon\" style=\"font-size:13px\">\n            </i>\n            <span data-kid=\"2-1-2-2\" data-name=\"online status text\">\n                ONLINE\n            </span>\n        </div>\n    </header>\n    <main data-kid=\"2-2\" data-name=\"main content area\" style=\"flex:1;padding:18px 20px;display:flex;flex-direction:column;gap:16px\">\n        <div data-kid=\"2-2-1\" data-name=\"ledger header section\" style=\"display:flex;justify-content:space-between;align-items:center\">\n            <div data-kid=\"2-2-1-1\" data-name=\"ledger section title container\">\n                <h2 data-kid=\"2-2-1-1-1\" data-name=\"ledger section title\" style=\"font-size:19px;font-weight:800\">\n                    Activity & Ledger\n                </h2>\n                <div data-kid=\"2-2-1-1-2\" data-name=\"ledger section description\" style=\"font-size:12px;color:var(--text-3)\">\n                    Offline store & settled transactions\n                </div>\n            </div>\n            <div data-kid=\"2-2-1-2\" data-name=\"refresh data button container\" style=\"width:34px;height:34px;border:1px solid var(--border-strong);display:flex;align-items:center;justify-content:center;color:var(--accent)\">\n                <i class=\"ph ph-arrow-clockwise\" data-kid=\"2-2-1-2-1\" data-name=\"refresh data icon\" style=\"font-size:17px\">\n                </i>\n            </div>\n        </div>\n        <div data-kid=\"2-2-2\" data-name=\"pending sync alert card\" style=\"background:var(--warning-weak);border:1px solid var(--warning);padding:16px;display:flex;flex-direction:column;gap:10px\">\n            <div data-kid=\"2-2-2-1\" data-name=\"alert header container\" style=\"display:flex;align-items:center;justify-content:space-between\">\n                <div data-kid=\"2-2-2-1-1\" data-name=\"alert title container\" style=\"display:flex;align-items:center;gap:8px\">\n                    <i class=\"ph ph-clock\" data-kid=\"2-2-2-1-1-1\" data-name=\"clock icon\" style=\"font-size:18px;color:var(--warning)\">\n                    </i>\n                    <span data-kid=\"2-2-2-1-1-2\" data-name=\"pending sync status text\" style=\"font-size:13px;font-weight:800;color:var(--warning)\">\n                        1 Payment in PENDING_SYNC\n                    </span>\n                </div>\n                <span data-kid=\"2-2-2-1-2\" data-name=\"local store badge\" style=\"padding:3px 8px;background:var(--surface);border:1px solid var(--warning);color:var(--warning);font-size:10px;font-weight:700\">\n                    LOCAL STORE\n                </span>\n            </div>\n            <p data-kid=\"2-2-2-2\" data-name=\"alert description text\" style=\"font-size:12px;color:var(--text-2);line-height:1.4\">\n                Stored locally in IndexedDB with cryptographic nonces. Ready to hop via Bluetooth mesh or upload when network is detected.\n            </p>\n            <button data-kid=\"2-2-2-3\" data-name=\"sync call-to-action button\" style=\"align-self:flex-start;height:38px;padding:0 14px;background:var(--brand);color:var(--on-brand);border:none;font-size:13px;font-weight:700;font-family:inherit;display:flex;align-items:center;gap:8px;cursor:pointer\">\n                <i class=\"ph ph-cloud-arrow-up\" data-kid=\"2-2-2-3-1\" data-name=\"cloud upload icon\" style=\"font-size:16px\">\n                </i>\n                <span data-kid=\"2-2-2-3-2\" data-name=\"sync button label\">\n                    Upload & Sync Now\n                </span>\n            </button>\n        </div>\n        <div data-kid=\"2-2-3\" data-name=\"offline store section\">\n            <div data-kid=\"2-2-3-1\" data-name=\"offline store section title\" style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:var(--text-3);letter-spacing:0.8px;margin-bottom:8px\">\n                IndexedDB Offline Store (1)\n            </div>\n            <div data-kid=\"2-2-3-2\" data-name=\"offline transaction card\" style=\"background:var(--card);border:1px solid var(--border);border-left:3px solid var(--warning);padding:14px 16px\">\n                <div data-kid=\"2-2-3-2-1\" data-name=\"transaction info container\" style=\"display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px\">\n                    <div data-kid=\"2-2-3-2-1-1\" data-name=\"transaction parties container\">\n                        <div data-kid=\"2-2-3-2-1-1-1\" data-name=\"recipient name\" style=\"font-size:14px;font-weight:700\">\n                            To: merchant@offset\n                        </div>\n                        <div data-kid=\"2-2-3-2-1-1-2\" data-name=\"sender name\" style=\"font-size:11px;color:var(--text-3)\">\n                            From: alice@offset\n                        </div>\n                    </div>\n                    <div data-kid=\"2-2-3-2-1-2\" data-name=\"transaction amount and status container\" style=\"text-align:right\">\n                        <div data-kid=\"2-2-3-2-1-2-1\" data-name=\"transaction amount\" style=\"font-size:16px;font-weight:800\">\n                            ₹100.00\n                        </div>\n                        <span data-kid=\"2-2-3-2-1-2-2\" data-name=\"pending status badge\" style=\"display:inline-flex;align-items:center;gap:4px;padding:2px 7px;background:var(--warning-weak);border:1px solid var(--warning);color:var(--warning);font-size:10px;font-weight:700;margin-top:3px\">\n                            <i class=\"ph ph-clock\" data-kid=\"2-2-3-2-1-2-2-1\" data-name=\"small clock icon\" style=\"font-size:10px\">\n                            </i>\n                            PENDING_SYNC\n                        </span>\n                    </div>\n                </div>\n                <div data-kid=\"2-2-3-2-2\" data-name=\"transaction metadata container\" style=\"display:flex;justify-content:space-between;font-size:11px;color:var(--text-3);border-top:1px solid var(--border);padding-top:6px;margin-top:6px\">\n                    <span data-kid=\"2-2-3-2-2-1\" data-name=\"transaction nonce text\">\n                        Nonce: nonce_8fa21c\n                    </span>\n                    <span data-kid=\"2-2-3-2-2-2\" data-name=\"transaction time text\">\n                        10:58 AM\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div data-kid=\"2-2-4\" data-name=\"ledger transaction history section\">\n            <div data-kid=\"2-2-4-1\" data-name=\"ledger section title\" style=\"font-size:11px;font-weight:700;text-transform:uppercase;color:var(--text-3);letter-spacing:0.8px;margin-bottom:8px\">\n                Server Ledger Transactions (2)\n            </div>\n            <div data-kid=\"2-2-4-2\" data-name=\"ledger transactions list container\" style=\"display:flex;flex-direction:column;gap:10px\">\n                <div data-kid=\"2-2-4-2-1\" data-name=\"settled transaction card one\" style=\"background:var(--card);border:1px solid var(--border);padding:14px 16px\">\n                    <div data-kid=\"2-2-4-2-1-1\" data-name=\"transaction one info container\" style=\"display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px\">\n                        <div data-kid=\"2-2-4-2-1-1-1\" data-name=\"transaction one parties container\">\n                            <div data-kid=\"2-2-4-2-1-1-1-1\" data-name=\"transaction one recipient name\" style=\"font-size:14px;font-weight:700\">\n                                To: cafe@offset\n                            </div>\n                            <div data-kid=\"2-2-4-2-1-1-1-2\" data-name=\"transaction one sender name\" style=\"font-size:11px;color:var(--text-3)\">\n                                From: alice@offset\n                            </div>\n                        </div>\n                        <div data-kid=\"2-2-4-2-1-1-2\" data-name=\"transaction one amount and status container\" style=\"text-align:right\">\n                            <div data-kid=\"2-2-4-2-1-1-2-1\" data-name=\"transaction one amount\" style=\"font-size:16px;font-weight:800\">\n                                ₹250.00\n                            </div>\n                            <span data-kid=\"2-2-4-2-1-1-2-2\" data-name=\"transaction one settled badge\" style=\"display:inline-flex;align-items:center;gap:4px;padding:2px 7px;background:var(--success-weak);border:1px solid var(--success);color:var(--success);font-size:10px;font-weight:700;margin-top:3px\">\n                                <i class=\"ph ph-check-circle\" data-kid=\"2-2-4-2-1-1-2-2-1\" data-name=\"checkmark icon\" style=\"font-size:10px\">\n                                </i>\n                                SETTLED\n                            </span>\n                        </div>\n                    </div>\n                    <div data-kid=\"2-2-4-2-1-2\" data-name=\"transaction one metadata container\" style=\"display:flex;justify-content:space-between;font-size:11px;color:var(--text-3);border-top:1px solid var(--border);padding-top:6px;margin-top:6px\">\n                        <span data-kid=\"2-2-4-2-1-2-1\" data-name=\"transaction one bridge info\">\n                            Bridge: bridge-01 (2 hops)\n                        </span>\n                        <span data-kid=\"2-2-4-2-1-2-2\" data-name=\"transaction one time text\">\n                            09:14 AM\n                        </span>\n                    </div>\n                </div>\n                <div data-kid=\"2-2-4-2-2\" data-name=\"settled transaction card two\" style=\"background:var(--card);border:1px solid var(--border);padding:14px 16px\">\n                    <div data-kid=\"2-2-4-2-2-1\" data-name=\"transaction two info container\" style=\"display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px\">\n                        <div data-kid=\"2-2-4-2-2-1-1\" data-name=\"transaction two parties container\">\n                            <div data-kid=\"2-2-4-2-2-1-1-1\" data-name=\"transaction two recipient name\" style=\"font-size:14px;font-weight:700\">\n                                To: store@offset\n                            </div>\n                            <div data-kid=\"2-2-4-2-2-1-1-2\" data-name=\"transaction two sender name\" style=\"font-size:11px;color:var(--text-3)\">\n                                From: alice@offset\n                            </div>\n                        </div>\n                        <div data-kid=\"2-2-4-2-2-1-2\" data-name=\"transaction two amount and status container\" style=\"text-align:right\">\n                            <div data-kid=\"2-2-4-2-2-1-2-1\" data-name=\"transaction two amount\" style=\"font-size:16px;font-weight:800\">\n                                ₹1,400.00\n                            </div>\n                            <span data-kid=\"2-2-4-2-2-1-2-2\" data-name=\"transaction two settled badge\" style=\"display:inline-flex;align-items:center;gap:4px;padding:2px 7px;background:var(--success-weak);border:1px solid var(--success);color:var(--success);font-size:10px;font-weight:700;margin-top:3px\">\n                                <i class=\"ph ph-check-circle\" data-kid=\"2-2-4-2-2-1-2-2-1\" data-name=\"checkmark icon\" style=\"font-size:10px\">\n                                </i>\n                                SETTLED\n                            </span>\n                        </div>\n                    </div>\n                    <div data-kid=\"2-2-4-2-2-2\" data-name=\"transaction two metadata container\" style=\"display:flex;justify-content:space-between;font-size:11px;color:var(--text-3);border-top:1px solid var(--border);padding-top:6px;margin-top:6px\">\n                        <span data-kid=\"2-2-4-2-2-2-1\" data-name=\"transaction two bridge info\">\n                            Bridge: online (0 hops)\n                        </span>\n                        <span data-kid=\"2-2-4-2-2-2-2\" data-name=\"transaction two time text\">\n                            Yesterday\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </main>\n    <nav data-kid=\"2-3\" data-name=\"bottom navigation bar\" style=\"display:flex;align-items:center;justify-content:space-around;padding:10px 10px 12px;border-top:1px solid var(--border);background:var(--surface)\">\n        <div data-kid=\"2-3-1\" data-name=\"home navigation item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--text-3)\">\n            <i class=\"ph ph-house\" data-kid=\"2-3-1-1\" data-name=\"home icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-1-2\" data-name=\"home label\" style=\"font-size:10px;font-weight:700\">\n                Home\n            </span>\n        </div>\n        <div data-kid=\"2-3-2\" data-name=\"wallet navigation item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--text-3)\">\n            <i class=\"ph ph-wallet\" data-kid=\"2-3-2-1\" data-name=\"wallet icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-2-2\" data-name=\"wallet label\" style=\"font-size:10px;font-weight:700\">\n                Wallet\n            </span>\n        </div>\n        <div data-kid=\"2-3-3\" data-name=\"qr scan button\" style=\"width:46px;height:46px;background:var(--brand);display:flex;align-items:center;justify-content:center;color:var(--on-brand)\">\n            <i class=\"ph ph-qr-code\" data-kid=\"2-3-3-1\" data-name=\"qr code icon\" style=\"font-size:24px\">\n            </i>\n        </div>\n        <div data-kid=\"2-3-4\" data-name=\"activity navigation item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--accent)\">\n            <i class=\"ph ph-arrows-left-right\" data-kid=\"2-3-4-1\" data-name=\"activity icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-4-2\" data-name=\"activity label\" style=\"font-size:10px;font-weight:700\">\n                Activity\n            </span>\n        </div>\n        <div data-kid=\"2-3-5\" data-name=\"profile navigation item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--text-3)\">\n            <i class=\"ph ph-user\" data-kid=\"2-3-5-1\" data-name=\"profile icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-5-2\" data-name=\"profile label\" style=\"font-size:10px;font-weight:700\">\n                Profile\n            </span>\n        </div>\n    </nav>\n</div>\n",

      "html": "<link data-kid=\"1\" href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n.scope{--bg:#0b0f0e;--surface:#141a18;--card:#141a18;--border:#26302d;--border-strong:#394641;--text:#f3f6f4;--text-2:#9fb0a9;--text-3:#6a7a73;--accent:#10b981;--brand:#059669;--on-brand:#ffffff;--accent-weak:#0f2a22;--success:#10b981;--success-weak:#0f2a22;--warning:#f59e0b;--warning-weak:#2a2010;--danger:#f87171;--danger-weak:#2a1618;}\n</style>\n<div class=\"scope\" data-kid=\"2\" data-name=\"mobile wallet interface container\" style=\"width:375px;min-height:812px;background:var(--bg);color:var(--text);font-family:'Plus Jakarta Sans',sans-serif;display:flex;flex-direction:column\">\n    <header data-kid=\"2-1\" data-name=\"app header bar\" style=\"display:flex;align-items:center;justify-content:space-between;padding:15px 20px;border-bottom:1px solid var(--border);background:var(--surface)\">\n        <div data-kid=\"2-1-1\" data-name=\"app branding area\" style=\"display:flex;align-items:center;gap:10px\">\n            <div data-kid=\"2-1-1-1\" data-name=\"radio icon container\" style=\"width:34px;height:34px;background:var(--brand);display:flex;align-items:center;justify-content:center\">\n                <svg data-kid=\"2-1-1-1-1\" data-name=\"custom logo svg icon\" fill=\"none\" height=\"20\" viewbox=\"0 0 24 24\" width=\"20\">\n                    <rect height=\"12\" stroke=\"#fff\" stroke-width=\"2\" width=\"12\" x=\"3.5\" y=\"3.5\">\n                    </rect>\n                    <rect fill=\"#fff\" height=\"11\" width=\"11\" x=\"9.5\" y=\"9.5\">\n                    </rect>\n                </svg>\n            </div>\n            <div data-kid=\"2-1-1-2\" data-name=\"app title group\">\n                <div data-kid=\"2-1-1-2-1\" data-name=\"app title text\" style=\"font-size:15px;font-weight:800;letter-spacing:-0.3px;line-height:1.1\">\n                    OffSet\n                </div>\n                <div data-kid=\"2-1-1-2-2\" data-name=\"app subtitle text\" style=\"font-size:9px;color:var(--text-3);font-weight:700;text-transform:uppercase;letter-spacing:1.2px\">\n                    Offline Mesh\n                </div>\n            </div>\n        </div>\n        <div data-kid=\"2-1-2\" data-name=\"online status badge\" style=\"display:inline-flex;align-items:center;gap:6px;padding:5px 10px;background:var(--success-weak);border:1px solid var(--success);color:var(--success);font-size:11px;font-weight:700\">\n            <i class=\"ph ph-wifi-high\" data-kid=\"2-1-2-1\" data-name=\"wifi high signal icon\" style=\"font-size:13px\">\n            </i>\n            <span data-kid=\"2-1-2-2\" data-name=\"status label text\">\n                ONLINE\n            </span>\n        </div>\n    </header>\n    <main data-kid=\"2-2\" data-name=\"main content area\" style=\"flex:1;padding:18px 20px;display:flex;flex-direction:column;gap:16px\">\n        <div data-kid=\"2-2-1\" data-name=\"user greeting and info section\" style=\"display:flex;justify-content:space-between;align-items:flex-start\">\n            <div data-kid=\"2-2-1-1\" data-name=\"user details area\">\n                <div data-kid=\"2-2-1-1-1\" data-name=\"welcome message text\" style=\"font-size:12px;color:var(--text-2);font-weight:600\">\n                    Welcome back,\n                </div>\n                <div data-kid=\"2-2-1-1-2\" data-name=\"user name text\" style=\"font-size:22px;font-weight:800;letter-spacing:-0.4px;margin-top:2px\">\n                    ALICE\n                </div>\n                <div data-kid=\"2-2-1-1-3\" data-name=\"user email address text\" style=\"font-size:12px;color:var(--accent);font-weight:700;margin-top:2px\">\n                    alice@offset\n                </div>\n            </div>\n            <div data-kid=\"2-2-1-2\" data-name=\"version badge\" style=\"display:inline-flex;align-items:center;gap:6px;padding:5px 10px;background:var(--accent-weak);border:1px solid var(--brand);color:var(--accent);font-size:11px;font-weight:700\">\n                <i class=\"ph ph-seal-check\" data-kid=\"2-2-1-2-1\" data-name=\"check mark seal icon\" style=\"font-size:13px\">\n                </i>\n                <span data-kid=\"2-2-1-2-2\" data-name=\"version number text\">\n                    v1.0\n                </span>\n            </div>\n        </div>\n        <div data-kid=\"2-2-2\" data-name=\"offline wallet balance card\" style=\"background:var(--brand);color:var(--on-brand);padding:22px\">\n            <div data-kid=\"2-2-2-1\" data-name=\"balance card header\" style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:14px\">\n                <span data-kid=\"2-2-2-1-1\" data-name=\"balance header label text\" style=\"font-size:11px;font-weight:700;letter-spacing:1px;opacity:.85\">\n                    OFFLINE WALLET BALANCE\n                </span>\n                <i class=\"ph ph-arrow-clockwise\" data-kid=\"2-2-2-1-2\" data-name=\"refresh balance icon\" style=\"font-size:16px;opacity:.85\">\n                </i>\n            </div>\n            <div data-kid=\"2-2-2-2\" data-name=\"balance amount text\" style=\"font-size:36px;font-weight:800;letter-spacing:-0.5px\">\n                ₹1,250.00\n            </div>\n            <div data-kid=\"2-2-2-3\" data-name=\"limits display group\" style=\"display:flex;gap:22px;margin-top:14px;font-size:12px;opacity:.9\">\n                <div data-kid=\"2-2-2-3-1\" data-name=\"transaction limit container\">\n                    Tx Limit\n                    <strong data-kid=\"2-2-2-3-1-1\" data-name=\"transaction limit value text\">\n                        ₹2,000\n                    </strong>\n                </div>\n                <div data-kid=\"2-2-2-3-2\" data-name=\"daily limit container\">\n                    Daily Limit\n                    <strong data-kid=\"2-2-2-3-2-1\" data-name=\"daily limit value text\">\n                        ₹10,000\n                    </strong>\n                </div>\n            </div>\n        </div>\n        <div data-kid=\"2-2-3\" data-name=\"wallet action menu grid\" style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:12px\">\n            <div data-kid=\"2-2-3-1\" data-name=\"scan and pay button\" style=\"background:var(--surface);border:1px solid var(--border);padding:16px 6px;display:flex;flex-direction:column;align-items:center;gap:10px\">\n                <div data-kid=\"2-2-3-1-1\" data-name=\"scan and pay icon container\" style=\"width:40px;height:40px;background:var(--accent-weak);display:flex;align-items:center;justify-content:center\">\n                    <i class=\"ph ph-qr-code\" data-kid=\"2-2-3-1-1-1\" data-name=\"qr code icon\" style=\"font-size:20px;color:var(--accent)\">\n                    </i>\n                </div>\n                <span data-kid=\"2-2-3-1-2\" data-name=\"scan and pay label text\" style=\"font-size:12px;font-weight:700\">\n                    Scan & Pay\n                </span>\n            </div>\n            <div data-kid=\"2-2-3-2\" data-name=\"fund button\" style=\"background:var(--surface);border:1px solid var(--border);padding:16px 6px;display:flex;flex-direction:column;align-items:center;gap:10px\">\n                <div data-kid=\"2-2-3-2-1\" data-name=\"fund icon container\" style=\"width:40px;height:40px;background:var(--accent-weak);display:flex;align-items:center;justify-content:center\">\n                    <i class=\"ph ph-arrow-down-left\" data-kid=\"2-2-3-2-1-1\" data-name=\"down-left arrow icon\" style=\"font-size:20px;color:var(--accent)\">\n                    </i>\n                </div>\n                <span data-kid=\"2-2-3-2-2\" data-name=\"fund label text\" style=\"font-size:12px;font-weight:700\">\n                    Fund\n                </span>\n            </div>\n            <div data-kid=\"2-2-3-3\" data-name=\"activity button\" style=\"background:var(--surface);border:1px solid var(--border);padding:16px 6px;display:flex;flex-direction:column;align-items:center;gap:10px\">\n                <div data-kid=\"2-2-3-3-1\" data-name=\"activity icon container\" style=\"width:40px;height:40px;background:var(--warning-weak);display:flex;align-items:center;justify-content:center\">\n                    <i class=\"ph ph-arrow-up-right\" data-kid=\"2-2-3-3-1-1\" data-name=\"up-right arrow icon\" style=\"font-size:20px;color:var(--warning)\">\n                    </i>\n                </div>\n                <span data-kid=\"2-2-3-3-2\" data-name=\"activity label text\" style=\"font-size:12px;font-weight:700\">\n                    Activity\n                </span>\n            </div>\n        </div>\n        <div data-kid=\"2-2-4\" data-name=\"mesh network status card\" style=\"background:var(--card);border:1px solid var(--border);padding:16px;display:flex;align-items:center;gap:14px\">\n            <div data-kid=\"2-2-4-1\" data-name=\"mesh status icon container\" style=\"width:44px;height:44px;background:var(--accent-weak);display:flex;align-items:center;justify-content:center;flex-shrink:0\">\n                <i class=\"ph ph-wifi-slash\" data-kid=\"2-2-4-1-1\" data-name=\"wifi slash icon\" style=\"font-size:22px;color:var(--accent)\">\n                </i>\n            </div>\n            <div data-kid=\"2-2-4-2\" data-name=\"mesh status description area\" style=\"flex:1\">\n                <div data-kid=\"2-2-4-2-1\" data-name=\"mesh status title text\" style=\"font-size:14px;font-weight:700\">\n                    Mesh Network Ready\n                </div>\n                <div data-kid=\"2-2-4-2-2\" data-name=\"mesh status detail text\" style=\"font-size:12px;color:var(--text-3);margin-top:2px\">\n                    Transactions sign locally and hop via mesh to bridge nodes\n                </div>\n            </div>\n            <div data-kid=\"2-2-4-3\" data-name=\"sync status count badge\" style=\"padding:4px 8px;background:var(--success-weak);border:1px solid var(--success);color:var(--success);font-size:10px;font-weight:700;flex-shrink:0\">\n                0 SYNC\n            </div>\n        </div>\n        <div data-kid=\"2-2-5\" data-name=\"security info bar\" style=\"background:var(--surface);border:1px solid var(--border);padding:12px 14px;display:flex;align-items:center;gap:10px;font-size:12px;color:var(--text-2)\">\n            <i class=\"ph ph-shield-check\" data-kid=\"2-2-5-1\" data-name=\"shield check icon\" style=\"font-size:16px;color:var(--accent)\">\n            </i>\n            <span data-kid=\"2-2-5-2\" data-name=\"security features description text\">\n                Hybrid RSA-2048 + AES-GCM replay-protected ledger\n            </span>\n        </div>\n    </main>\n    <nav data-kid=\"2-3\" data-name=\"bottom navigation menu\" style=\"display:flex;align-items:center;justify-content:space-around;padding:10px 10px 12px;border-top:1px solid var(--border);background:var(--surface)\">\n        <div data-kid=\"2-3-1\" data-name=\"home navigation item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--accent)\">\n            <i class=\"ph ph-house\" data-kid=\"2-3-1-1\" data-name=\"home icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-1-2\" data-name=\"home label text\" style=\"font-size:10px;font-weight:700\">\n                Home\n            </span>\n        </div>\n        <div data-kid=\"2-3-2\" data-name=\"wallet navigation item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--text-3)\">\n            <i class=\"ph ph-wallet\" data-kid=\"2-3-2-1\" data-name=\"wallet icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-2-2\" data-name=\"wallet label text\" style=\"font-size:10px;font-weight:700\">\n                Wallet\n            </span>\n        </div>\n        <div data-kid=\"2-3-3\" data-name=\"qr code action button\" style=\"width:46px;height:46px;background:var(--brand);display:flex;align-items:center;justify-content:center;color:var(--on-brand)\">\n            <i class=\"ph ph-qr-code\" data-kid=\"2-3-3-1\" data-name=\"center qr code icon\" style=\"font-size:24px\">\n            </i>\n        </div>\n        <div data-kid=\"2-3-4\" data-name=\"activity navigation item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--text-3)\">\n            <i class=\"ph ph-arrows-left-right\" data-kid=\"2-3-4-1\" data-name=\"arrow left-right icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-4-2\" data-name=\"activity label text\" style=\"font-size:10px;font-weight:700\">\n                Activity\n            </span>\n        </div>\n        <div data-kid=\"2-3-5\" data-name=\"profile navigation item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--text-3)\">\n            <i class=\"ph ph-user\" data-kid=\"2-3-5-1\" data-name=\"profile icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-5-2\" data-name=\"profile label text\" style=\"font-size:10px;font-weight:700\">\n                Profile\n            </span>\n        </div>\n    </nav>\n</div>\n",

      "html": "<link data-kid=\"1\" data-name=\"google fonts stylesheet link\" href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n.scope{--bg:#0b0f0e;--surface:#141a18;--card:#141a18;--border:#26302d;--border-strong:#394641;--text:#f3f6f4;--text-2:#9fb0a9;--text-3:#6a7a73;--accent:#10b981;--brand:#059669;--on-brand:#ffffff;--accent-weak:#0f2a22;--success:#10b981;--success-weak:#0f2a22;--warning:#f59e0b;--warning-weak:#2a2010;--danger:#f87171;--danger-weak:#2a1618;}\n</style>\n<div class=\"scope\" data-kid=\"2\" data-name=\"main layout scope\" style=\"width:375px;min-height:812px;background:var(--bg);color:var(--text);font-family:'Plus Jakarta Sans',sans-serif;display:flex;flex-direction:column\">\n    <header data-kid=\"2-1\" data-name=\"header container\" style=\"display:flex;align-items:center;justify-content:space-between;padding:15px 20px;border-bottom:1px solid var(--border);background:var(--surface)\">\n        <div data-kid=\"2-1-1\" data-name=\"brand and status container\" style=\"display:flex;align-items:center;gap:10px\">\n            <div data-kid=\"2-1-1-1\" data-name=\"brand logo background square\" style=\"width:34px;height:34px;background:var(--brand);display:flex;align-items:center;justify-content:center\">\n                <svg data-kid=\"2-1-1-1-1\" data-name=\"brand logo icon\" fill=\"none\" height=\"20\" viewbox=\"0 0 24 24\" width=\"20\">\n                    <rect height=\"12\" stroke=\"#fff\" stroke-width=\"2\" width=\"12\" x=\"3.5\" y=\"3.5\">\n                    </rect>\n                    <rect fill=\"#fff\" height=\"11\" width=\"11\" x=\"9.5\" y=\"9.5\">\n                    </rect>\n                </svg>\n            </div>\n            <div data-kid=\"2-1-1-2\" data-name=\"app identity text container\">\n                <div data-kid=\"2-1-1-2-1\" data-name=\"app name text\" style=\"font-size:15px;font-weight:800;letter-spacing:-0.3px;line-height:1.1\">\n                    OffSet\n                </div>\n                <div data-kid=\"2-1-1-2-2\" data-name=\"app subtitle text\" style=\"font-size:9px;color:var(--text-3);font-weight:700;text-transform:uppercase;letter-spacing:1.2px\">\n                    Offline Mesh\n                </div>\n            </div>\n        </div>\n        <div data-kid=\"2-1-2\" data-name=\"connection status indicator\" style=\"display:inline-flex;align-items:center;gap:6px;padding:5px 10px;background:var(--success-weak);border:1px solid var(--success);color:var(--success);font-size:11px;font-weight:700\">\n            <i class=\"ph ph-wifi-high\" data-kid=\"2-1-2-1\" data-name=\"wifi signal icon\" style=\"font-size:13px\">\n            </i>\n            <span data-kid=\"2-1-2-2\" data-name=\"connection status text\">\n                ONLINE\n            </span>\n        </div>\n    </header>\n    <main data-kid=\"2-2\" data-name=\"main content container\" style=\"flex:1;padding:18px 20px;display:flex;flex-direction:column;gap:16px\">\n        <div data-kid=\"2-2-1\" data-name=\"page header container\">\n            <h2 data-kid=\"2-2-1-1\" data-name=\"page title headline\" style=\"font-size:19px;font-weight:800\">\n                Profile & Settings\n            </h2>\n            <div data-kid=\"2-2-1-2\" data-name=\"page description text\" style=\"font-size:12px;color:var(--text-3)\">\n                Node credentials and device preferences\n            </div>\n        </div>\n        <div data-kid=\"2-2-2\" data-name=\"user profile info card\" style=\"background:var(--card);border:1px solid var(--border);padding:18px;display:flex;align-items:center;gap:16px\">\n            <div data-kid=\"2-2-2-1\" data-name=\"user avatar placeholder\" style=\"width:52px;height:52px;background:var(--brand);display:flex;align-items:center;justify-content:center;color:var(--on-brand);font-size:22px;font-weight:800\">\n                A\n            </div>\n            <div data-kid=\"2-2-2-2\" data-name=\"user details container\">\n                <div data-kid=\"2-2-2-2-1\" data-name=\"user display name\" style=\"font-size:16px;font-weight:800\">\n                    ALICE\n                </div>\n                <div data-kid=\"2-2-2-2-2\" data-name=\"user handle text\" style=\"font-size:13px;color:var(--accent);font-weight:700\">\n                    alice@offset\n                </div>\n                <div data-kid=\"2-2-2-2-3\" data-name=\"auth status text\" style=\"font-size:11px;color:var(--text-3);margin-top:2px\">\n                    Bearer JWT Authentication Active\n                </div>\n            </div>\n        </div>\n        <div data-kid=\"2-2-3\" data-name=\"appearance setting container\" style=\"background:var(--card);border:1px solid var(--border);padding:18px\">\n            <h3 data-kid=\"2-2-3-1\" data-name=\"appearance section title\" style=\"font-size:14px;font-weight:800;margin-bottom:12px\">\n                Appearance\n            </h3>\n            <div data-kid=\"2-2-3-2\" data-name=\"theme selection toggle\" style=\"display:flex;border:1px solid var(--border-strong)\">\n                <div data-kid=\"2-2-3-2-1\" data-name=\"dark theme selection option\" style=\"flex:1;text-align:center;padding:10px;font-size:13px;font-weight:700;background:var(--brand);color:var(--on-brand);display:flex;align-items:center;justify-content:center;gap:6px\">\n                    <i class=\"ph ph-moon\" data-kid=\"2-2-3-2-1-1\" data-name=\"moon icon\" style=\"font-size:15px\">\n                    </i>\n                    Dark\n                </div>\n                <div data-kid=\"2-2-3-2-2\" data-name=\"light theme selection option\" style=\"flex:1;text-align:center;padding:10px;font-size:13px;font-weight:700;color:var(--text-2);display:flex;align-items:center;justify-content:center;gap:6px\">\n                    <i class=\"ph ph-sun\" data-kid=\"2-2-3-2-2-1\" data-name=\"sun icon\" style=\"font-size:15px\">\n                    </i>\n                    Light\n                </div>\n            </div>\n        </div>\n        <div data-kid=\"2-2-4\" data-name=\"device configuration container\" style=\"background:var(--card);border:1px solid var(--border);padding:18px\">\n            <h3 data-kid=\"2-2-4-1\" data-name=\"device configuration title\" style=\"font-size:14px;font-weight:800;margin-bottom:14px\">\n                Device Configuration\n            </h3>\n            <div data-kid=\"2-2-4-2\" data-name=\"device info list container\" style=\"display:flex;flex-direction:column;gap:14px\">\n                <div data-kid=\"2-2-4-2-1\" data-name=\"platform row container\" style=\"display:flex;align-items:center;gap:10px;font-size:13px\">\n                    <i class=\"ph ph-device-mobile\" data-kid=\"2-2-4-2-1-1\" data-name=\"mobile device icon\" style=\"font-size:17px;color:var(--text-3)\">\n                    </i>\n                    <span data-kid=\"2-2-4-2-1-2\" data-name=\"platform label text\" style=\"color:var(--text-2);flex:1\">\n                        Client Platform\n                    </span>\n                    <strong data-kid=\"2-2-4-2-1-3\" data-name=\"platform value text\">\n                        Capacitor / Android\n                    </strong>\n                </div>\n                <div data-kid=\"2-2-4-2-2\" data-name=\"crypto row container\" style=\"display:flex;align-items:center;gap:10px;font-size:13px\">\n                    <i class=\"ph ph-cpu\" data-kid=\"2-2-4-2-2-1\" data-name=\"cpu chip icon\" style=\"font-size:17px;color:var(--text-3)\">\n                    </i>\n                    <span data-kid=\"2-2-4-2-2-2\" data-name=\"crypto engine label text\" style=\"color:var(--text-2);flex:1\">\n                        Crypto Engine\n                    </span>\n                    <strong data-kid=\"2-2-4-2-2-3\" data-name=\"crypto engine value text\">\n                        RSA-2048 + AES-GCM\n                    </strong>\n                </div>\n                <div data-kid=\"2-2-4-2-3\" data-name=\"replay protection row container\" style=\"display:flex;align-items:center;gap:10px;font-size:13px\">\n                    <i class=\"ph ph-shield-check\" data-kid=\"2-2-4-2-3-1\" data-name=\"shield check icon\" style=\"font-size:17px;color:var(--accent)\">\n                    </i>\n                    <span data-kid=\"2-2-4-2-3-2\" data-name=\"replay protection label text\" style=\"color:var(--text-2);flex:1\">\n                        Replay Protection\n                    </span>\n                    <strong data-kid=\"2-2-4-2-3-3\" data-name=\"replay protection value text\" style=\"color:var(--accent)\">\n                        Atomic Nonce\n                    </strong>\n                </div>\n            </div>\n        </div>\n        <button data-kid=\"2-2-5\" data-name=\"sign out button\" style=\"width:100%;height:48px;background:var(--danger-weak);border:1px solid var(--danger);color:var(--danger);font-weight:700;font-size:15px;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px;cursor:pointer\">\n            <i class=\"ph ph-sign-out\" data-kid=\"2-2-5-1\" data-name=\"sign out icon\" style=\"font-size:18px\">\n            </i>\n            <span data-kid=\"2-2-5-2\" data-name=\"sign out button text\">\n                Sign Out\n            </span>\n        </button>\n        <div data-kid=\"2-2-6\" data-name=\"app version and foundation footer\" style=\"text-align:center;font-size:11px;color:var(--text-3)\">\n            OffSet Research Prototype • Mobile Foundation\n        </div>\n    </main>\n    <nav data-kid=\"2-3\" data-name=\"bottom navigation bar\" style=\"display:flex;align-items:center;justify-content:space-around;padding:10px 10px 12px;border-top:1px solid var(--border);background:var(--surface)\">\n        <div data-kid=\"2-3-1\" data-name=\"home nav item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--text-3)\">\n            <i class=\"ph ph-house\" data-kid=\"2-3-1-1\" data-name=\"home icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-1-2\" data-name=\"home label text\" style=\"font-size:10px;font-weight:700\">\n                Home\n            </span>\n        </div>\n        <div data-kid=\"2-3-2\" data-name=\"wallet nav item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--text-3)\">\n            <i class=\"ph ph-wallet\" data-kid=\"2-3-2-1\" data-name=\"wallet icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-2-2\" data-name=\"wallet label text\" style=\"font-size:10px;font-weight:700\">\n                Wallet\n            </span>\n        </div>\n        <div data-kid=\"2-3-3\" data-name=\"qr scan button container\" style=\"width:46px;height:46px;background:var(--brand);display:flex;align-items:center;justify-content:center;color:var(--on-brand)\">\n            <i class=\"ph ph-qr-code\" data-kid=\"2-3-3-1\" data-name=\"qr code icon\" style=\"font-size:24px\">\n            </i>\n        </div>\n        <div data-kid=\"2-3-4\" data-name=\"activity nav item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--text-3)\">\n            <i class=\"ph ph-arrows-left-right\" data-kid=\"2-3-4-1\" data-name=\"arrows icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-4-2\" data-name=\"activity label text\" style=\"font-size:10px;font-weight:700\">\n                Activity\n            </span>\n        </div>\n        <div data-kid=\"2-3-5\" data-name=\"profile nav item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--accent)\">\n            <i class=\"ph ph-user\" data-kid=\"2-3-5-1\" data-name=\"profile icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-5-2\" data-name=\"profile label text\" style=\"font-size:10px;font-weight:700\">\n                Profile\n            </span>\n        </div>\n    </nav>\n</div>\n",

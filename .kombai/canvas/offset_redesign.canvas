      "html": "<link data-kid=\"1\" data-name=\"google fonts stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n.scope{--bg:#0b0f0e;--surface:#141a18;--card:#141a18;--border:#26302d;--border-strong:#394641;--text:#f3f6f4;--text-2:#9fb0a9;--text-3:#6a7a73;--accent:#10b981;--brand:#059669;--on-brand:#ffffff;--accent-weak:#0f2a22;--success:#10b981;--success-weak:#0f2a22;--warning:#f59e0b;--warning-weak:#2a2010;--danger:#f87171;--danger-weak:#2a1618;}\n</style>\n<div class=\"scope\" data-kid=\"2\" data-name=\"app container\" style=\"width:375px;min-height:812px;background:var(--bg);color:var(--text);font-family:'Plus Jakarta Sans',sans-serif;display:flex;flex-direction:column\">\n    <header data-kid=\"2-1\" data-name=\"header bar\" style=\"display:flex;align-items:center;justify-content:space-between;padding:15px 20px;border-bottom:1px solid var(--border);background:var(--surface)\">\n        <div data-kid=\"2-1-1\" data-name=\"brand identity group\" style=\"display:flex;align-items:center;gap:10px\">\n            <div data-kid=\"2-1-1-1\" data-name=\"brand logo icon container\" style=\"width:34px;height:34px;background:var(--brand);display:flex;align-items:center;justify-content:center\">\n                <svg data-kid=\"2-1-1-1-1\" data-name=\"brand logo icon\" fill=\"none\" height=\"20\" viewbox=\"0 0 24 24\" width=\"20\">\n                    <rect height=\"12\" stroke=\"#fff\" stroke-width=\"2\" width=\"12\" x=\"3.5\" y=\"3.5\">\n                    </rect>\n                    <rect fill=\"#fff\" height=\"11\" width=\"11\" x=\"9.5\" y=\"9.5\">\n                    </rect>\n                </svg>\n            </div>\n            <div data-kid=\"2-1-1-2\" data-name=\"brand identity text\">\n                <div data-kid=\"2-1-1-2-1\" data-name=\"app name\" style=\"font-size:15px;font-weight:800;letter-spacing:-0.3px;line-height:1.1\">\n                    OffSet\n                </div>\n                <div data-kid=\"2-1-1-2-2\" data-name=\"app tag line\" style=\"font-size:9px;color:var(--text-3);font-weight:700;text-transform:uppercase;letter-spacing:1.2px\">\n                    Offline Mesh\n                </div>\n            </div>\n        </div>\n        <div data-kid=\"2-1-2\" data-name=\"offline status badge\" style=\"display:inline-flex;align-items:center;gap:6px;padding:5px 10px;background:var(--warning-weak);border:1px solid var(--warning);color:var(--warning);font-size:11px;font-weight:700\">\n            <i class=\"ph ph-wifi-slash\" data-kid=\"2-1-2-1\" data-name=\"offline icon\" style=\"font-size:13px\">\n            </i>\n            <span data-kid=\"2-1-2-2\" data-name=\"offline status text\">\n                OFFLINE\n            </span>\n        </div>\n    </header>\n    <main data-kid=\"2-2\" data-name=\"payment confirmation page\" style=\"flex:1;padding:18px 20px;display:flex;flex-direction:column;gap:16px\">\n        <div data-kid=\"2-2-1\" data-name=\"navigation back header\" style=\"display:flex;align-items:center;gap:10px\">\n            <div data-kid=\"2-2-1-1\" data-name=\"back button\" style=\"width:30px;height:30px;border:1px solid var(--border-strong);display:flex;align-items:center;justify-content:center;cursor:pointer\">\n                <i class=\"ph ph-arrow-left\" data-kid=\"2-2-1-1-1\" data-name=\"back arrow icon\" style=\"font-size:16px;color:var(--text)\">\n                </i>\n            </div>\n            <h2 data-kid=\"2-2-1-2\" data-name=\"page title\" style=\"font-size:18px;font-weight:800\">\n                Confirm Payment\n            </h2>\n        </div>\n        <div data-kid=\"2-2-2\" data-name=\"merchant profile card\" style=\"background:var(--card);border:1px solid var(--border);padding:16px;display:flex;align-items:center;gap:14px\">\n            <div data-kid=\"2-2-2-1\" data-name=\"merchant avatar initial\" style=\"width:46px;height:46px;background:var(--brand);display:flex;align-items:center;justify-content:center;color:var(--on-brand);font-size:20px;font-weight:800\">\n                M\n            </div>\n            <div data-kid=\"2-2-2-2\" data-name=\"merchant detail text\" style=\"flex:1\">\n                <div data-kid=\"2-2-2-2-1\" data-name=\"merchant name\" style=\"font-size:16px;font-weight:700\">\n                    Merchant Store\n                </div>\n                <div data-kid=\"2-2-2-2-2\" data-name=\"merchant username\" style=\"font-size:13px;color:var(--accent);font-weight:700\">\n                    merchant@offset\n                </div>\n            </div>\n            <i class=\"ph ph-seal-check\" data-kid=\"2-2-2-3\" data-name=\"verified merchant icon\" style=\"font-size:20px;color:var(--success)\">\n            </i>\n        </div>\n        <div data-kid=\"2-2-3\" data-name=\"payment input form\" style=\"background:var(--card);border:1px solid var(--border);padding:18px\">\n            <label data-kid=\"2-2-3-1\" data-name=\"amount label\" style=\"display:block;font-size:11px;font-weight:700;color:var(--text-2);margin-bottom:8px;text-transform:uppercase;letter-spacing:0.6px\">\n                Amount (₹)\n            </label>\n            <input data-dynamic=\"true\" data-kid=\"2-2-3-2\" data-name=\"amount input field\" data-reason=\"value initialized by user or preset\" style=\"width:100%;height:60px;padding:0 14px;background:var(--bg);border:1px solid var(--border-strong);color:var(--text);font-size:28px;font-weight:800;text-align:center;font-family:inherit;outline:none;margin-bottom:12px\" value=\"100\"/>\n            <div data-kid=\"2-2-3-3\" data-name=\"amount preset buttons group\" style=\"display:flex;gap:8px;margin-bottom:18px\">\n                <button data-kid=\"2-2-3-3-1\" data-name=\"preset amount button 50\" style=\"flex:1;height:34px;background:var(--surface);border:1px solid var(--border);color:var(--text);font-weight:700;font-size:12px;font-family:inherit;cursor:pointer\">\n                    ₹50\n                </button>\n                <button data-kid=\"2-2-3-3-2\" data-name=\"preset amount button 100\" style=\"flex:1;height:34px;background:var(--accent-weak);border:1px solid var(--brand);color:var(--accent);font-weight:700;font-size:12px;font-family:inherit;cursor:pointer\">\n                    ₹100\n                </button>\n                <button data-kid=\"2-2-3-3-3\" data-name=\"preset amount button 250\" style=\"flex:1;height:34px;background:var(--surface);border:1px solid var(--border);color:var(--text);font-weight:700;font-size:12px;font-family:inherit;cursor:pointer\">\n                    ₹250\n                </button>\n                <button data-kid=\"2-2-3-3-4\" data-name=\"preset amount button 500\" style=\"flex:1;height:34px;background:var(--surface);border:1px solid var(--border);color:var(--text);font-weight:700;font-size:12px;font-family:inherit;cursor:pointer\">\n                    ₹500\n                </button>\n            </div>\n            <label data-kid=\"2-2-3-4\" data-name=\"pin label\" style=\"display:block;font-size:11px;font-weight:700;color:var(--text-2);margin-bottom:8px;text-transform:uppercase;letter-spacing:0.6px\">\n                UPI PIN\n            </label>\n            <input data-dynamic=\"true\" data-kid=\"2-2-3-5\" data-name=\"pin input field\" data-reason=\"value initialized by user\" style=\"width:100%;height:50px;padding:0 14px;background:var(--bg);border:1px solid var(--border-strong);color:var(--text);font-size:22px;text-align:center;letter-spacing:10px;font-family:inherit;outline:none\" type=\"password\" value=\"1234\"/>\n        </div>\n        <div data-kid=\"2-2-4\" data-name=\"offline store and forward notification box\" style=\"background:var(--warning-weak);border:1px solid var(--warning);padding:14px;display:flex;align-items:flex-start;gap:10px\">\n            <i class=\"ph ph-wifi-slash\" data-kid=\"2-2-4-1\" data-name=\"warning icon\" style=\"font-size:18px;color:var(--warning);margin-top:1px\">\n            </i>\n            <div data-kid=\"2-2-4-2\" data-name=\"notification text group\" style=\"font-size:12px\">\n                <strong data-kid=\"2-2-4-2-1\" data-name=\"notification title\" style=\"color:var(--warning)\">\n                    Offline Mesh Store & Forward\n                </strong>\n                <div data-kid=\"2-2-4-2-2\" data-name=\"notification description\" style=\"color:var(--text-3);margin-top:2px\">\n                    Packet signed locally, stored in IndexedDB (PENDING_SYNC), hops via mesh nodes.\n                </div>\n            </div>\n        </div>\n        <button data-kid=\"2-2-5\" data-name=\"confirm payment button\" style=\"width:100%;height:52px;background:var(--brand);color:var(--on-brand);border:none;font-size:16px;font-weight:700;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px;cursor:pointer\">\n            <span data-dynamic=\"true\" data-kid=\"2-2-5-1\" data-name=\"pay button label\" data-reason=\"amount updated dynamically by UI state\">\n                Pay ₹100\n            </span>\n            <i class=\"ph ph-arrow-right\" data-kid=\"2-2-5-2\" data-name=\"pay arrow icon\" style=\"font-size:18px\">\n            </i>\n        </button>\n    </main>\n    <nav data-kid=\"2-3\" data-name=\"bottom navigation bar\" style=\"display:flex;align-items:center;justify-content:space-around;padding:10px 10px 12px;border-top:1px solid var(--border);background:var(--surface)\">\n        <div data-kid=\"2-3-1\" data-name=\"home navigation item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--text-3)\">\n            <i class=\"ph ph-house\" data-kid=\"2-3-1-1\" data-name=\"home icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-1-2\" data-name=\"home text\" style=\"font-size:10px;font-weight:700\">\n                Home\n            </span>\n        </div>\n        <div data-kid=\"2-3-2\" data-name=\"wallet navigation item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--text-3)\">\n            <i class=\"ph ph-wallet\" data-kid=\"2-3-2-1\" data-name=\"wallet icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-2-2\" data-name=\"wallet text\" style=\"font-size:10px;font-weight:700\">\n                Wallet\n            </span>\n        </div>\n        <div data-kid=\"2-3-3\" data-name=\"qr code action button\" style=\"width:46px;height:46px;background:var(--brand);display:flex;align-items:center;justify-content:center;color:var(--on-brand)\">\n            <i class=\"ph ph-qr-code\" data-kid=\"2-3-3-1\" data-name=\"qr code icon\" style=\"font-size:24px\">\n            </i>\n        </div>\n        <div data-kid=\"2-3-4\" data-name=\"activity navigation item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--text-3)\">\n            <i class=\"ph ph-arrows-left-right\" data-kid=\"2-3-4-1\" data-name=\"activity icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-4-2\" data-name=\"activity text\" style=\"font-size:10px;font-weight:700\">\n                Activity\n            </span>\n        </div>\n        <div data-kid=\"2-3-5\" data-name=\"profile navigation item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--text-3)\">\n            <i class=\"ph ph-user\" data-kid=\"2-3-5-1\" data-name=\"profile icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-5-2\" data-name=\"profile text\" style=\"font-size:10px;font-weight:700\">\n                Profile\n            </span>\n        </div>\n    </nav>\n</div>\n",

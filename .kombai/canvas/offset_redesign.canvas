      "html": "<link data-kid=\"1\" data-name=\"google fonts stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n.scope{--bg:#0b0f0e;--surface:#141a18;--card:#141a18;--border:#26302d;--border-strong:#394641;--text:#f3f6f4;--text-2:#9fb0a9;--text-3:#6a7a73;--accent:#10b981;--brand:#059669;--on-brand:#ffffff;--accent-weak:#0f2a22;--success:#10b981;--success-weak:#0f2a22;--warning:#f59e0b;--warning-weak:#2a2010;--danger:#f87171;--danger-weak:#2a1618;}\n</style>\n<div class=\"scope\" data-kid=\"2\" data-name=\"app layout container\" style=\"width:375px;min-height:812px;background:var(--bg);color:var(--text);font-family:'Plus Jakarta Sans',sans-serif;display:flex;flex-direction:column\">\n    <header data-kid=\"2-1\" data-name=\"app header bar\" style=\"display:flex;align-items:center;justify-content:space-between;padding:15px 20px;border-bottom:1px solid var(--border);background:var(--surface)\">\n        <div data-kid=\"2-1-1\" data-name=\"app branding container\" style=\"display:flex;align-items:center;gap:10px\">\n            <div data-kid=\"2-1-1-1\" data-name=\"brand logo icon container\" style=\"width:34px;height:34px;background:var(--brand);display:flex;align-items:center;justify-content:center\">\n                <svg data-kid=\"2-1-1-1-1\" data-name=\"app logo svg icon\" fill=\"none\" height=\"20\" viewbox=\"0 0 24 24\" width=\"20\">\n                    <rect height=\"12\" stroke=\"#fff\" stroke-width=\"2\" width=\"12\" x=\"3.5\" y=\"3.5\">\n                    </rect>\n                    <rect fill=\"#fff\" height=\"11\" width=\"11\" x=\"9.5\" y=\"9.5\">\n                    </rect>\n                </svg>\n            </div>\n            <div data-kid=\"2-1-1-2\" data-name=\"brand text container\">\n                <div data-kid=\"2-1-1-2-1\" data-name=\"brand name text\" style=\"font-size:15px;font-weight:800;letter-spacing:-0.3px;line-height:1.1\">\n                    OffSet\n                </div>\n                <div data-kid=\"2-1-1-2-2\" data-name=\"brand subtitle text\" style=\"font-size:9px;color:var(--text-3);font-weight:700;text-transform:uppercase;letter-spacing:1.2px\">\n                    Offline Mesh\n                </div>\n            </div>\n        </div>\n        <div data-kid=\"2-1-2\" data-name=\"online status badge\" style=\"display:inline-flex;align-items:center;gap:6px;padding:5px 10px;background:var(--success-weak);border:1px solid var(--success);color:var(--success);font-size:11px;font-weight:700\">\n            <i class=\"ph ph-wifi-high\" data-kid=\"2-1-2-1\" data-name=\"wifi signal icon\" style=\"font-size:13px\">\n            </i>\n            <span data-kid=\"2-1-2-2\" data-name=\"online status text\">\n                ONLINE\n            </span>\n        </div>\n    </header>\n    <main data-kid=\"2-2\" data-name=\"main content area\" style=\"flex:1;padding:18px 20px;display:flex;flex-direction:column;gap:16px\">\n        <div data-kid=\"2-2-1\" data-name=\"wallet header section\" style=\"display:flex;align-items:center;gap:12px\">\n            <div data-kid=\"2-2-1-1\" data-name=\"wallet icon container\" style=\"width:38px;height:38px;background:var(--accent-weak);display:flex;align-items:center;justify-content:center\">\n                <i class=\"ph ph-wallet\" data-kid=\"2-2-1-1-1\" data-name=\"wallet icon\" style=\"font-size:20px;color:var(--accent)\">\n                </i>\n            </div>\n            <div data-kid=\"2-2-1-2\" data-name=\"wallet title area\">\n                <h2 data-kid=\"2-2-1-2-1\" data-name=\"wallet title text\" style=\"font-size:19px;font-weight:800;letter-spacing:-0.3px\">\n                    Offline Wallet\n                </h2>\n                <div data-kid=\"2-2-1-2-2\" data-name=\"wallet description text\" style=\"font-size:12px;color:var(--text-3)\">\n                    Manage local balance and limits\n                </div>\n            </div>\n        </div>\n        <div data-kid=\"2-2-2\" data-name=\"balance display card\" style=\"background:var(--brand);color:var(--on-brand);padding:22px\">\n            <div data-kid=\"2-2-2-1\" data-name=\"available balance label\" style=\"font-size:11px;font-weight:700;letter-spacing:1px;opacity:.85;margin-bottom:8px\">\n                AVAILABLE OFFLINE BALANCE\n            </div>\n            <div data-kid=\"2-2-2-2\" data-name=\"available balance amount text\" style=\"font-size:38px;font-weight:800;letter-spacing:-0.5px\">\n                ₹1,250.00\n            </div>\n            <div data-kid=\"2-2-2-3\" data-name=\"wallet metadata text\" style=\"font-size:11px;opacity:.85;margin-top:12px\">\n                Wallet Version 1 • Owner: alice\n            </div>\n        </div>\n        <div data-kid=\"2-2-3\" data-name=\"enforced limits card\" style=\"background:var(--card);border:1px solid var(--border);padding:18px\">\n            <h3 data-kid=\"2-2-3-1\" data-name=\"enforced limits title\" style=\"font-size:14px;font-weight:800;margin-bottom:14px\">\n                Enforced Safety Limits\n            </h3>\n            <div data-kid=\"2-2-3-2\" data-name=\"limits list container\" style=\"display:flex;flex-direction:column;gap:12px\">\n                <div data-kid=\"2-2-3-2-1\" data-name=\"per-transaction limit row\" style=\"display:flex;justify-content:space-between;font-size:13px\">\n                    <span data-kid=\"2-2-3-2-1-1\" data-name=\"per-transaction limit label\" style=\"color:var(--text-2)\">\n                        Per-Transaction Limit\n                    </span>\n                    <strong data-kid=\"2-2-3-2-1-2\" data-name=\"per-transaction limit value\">\n                        ₹2,000.00\n                    </strong>\n                </div>\n                <div data-kid=\"2-2-3-2-2\" data-name=\"daily maximum limit row\" style=\"display:flex;justify-content:space-between;font-size:13px\">\n                    <span data-kid=\"2-2-3-2-2-1\" data-name=\"daily maximum limit label\" style=\"color:var(--text-2)\">\n                        Daily Maximum Limit\n                    </span>\n                    <strong data-kid=\"2-2-3-2-2-2\" data-name=\"daily maximum limit value\">\n                        ₹10,000.00\n                    </strong>\n                </div>\n                <div data-kid=\"2-2-3-2-3\" data-name=\"daily spent limit row\" style=\"display:flex;justify-content:space-between;font-size:13px\">\n                    <span data-kid=\"2-2-3-2-3-1\" data-name=\"daily spent limit label\" style=\"color:var(--text-2)\">\n                        Daily Used / Spent\n                    </span>\n                    <strong data-kid=\"2-2-3-2-3-2\" data-name=\"daily spent limit value\" style=\"color:var(--warning)\">\n                        ₹1,750.00\n                    </strong>\n                </div>\n                <div data-kid=\"2-2-3-2-4\" data-name=\"remaining limit row\" style=\"display:flex;justify-content:space-between;font-size:13px;padding-top:12px;border-top:1px solid var(--border)\">\n                    <span data-kid=\"2-2-3-2-4-1\" data-name=\"remaining limit label\" style=\"color:var(--text-2)\">\n                        Remaining Today\n                    </span>\n                    <strong data-kid=\"2-2-3-2-4-2\" data-name=\"remaining limit value\" style=\"color:var(--accent)\">\n                        ₹8,250.00\n                    </strong>\n                </div>\n            </div>\n        </div>\n        <div data-kid=\"2-2-4\" data-name=\"funding gateway card\" style=\"background:var(--card);border:1px solid var(--border);padding:18px\">\n            <h3 data-kid=\"2-2-4-1\" data-name=\"funding gateway title\" style=\"font-size:14px;font-weight:800;margin-bottom:4px\">\n                Mock Gateway Funding\n            </h3>\n            <p data-kid=\"2-2-4-2\" data-name=\"funding gateway description\" style=\"font-size:12px;color:var(--text-3);margin-bottom:16px\">\n                Load funds into your offline wallet for zero-network payments\n            </p>\n            <label data-kid=\"2-2-4-3\" data-name=\"funding amount input label\" style=\"display:block;font-size:11px;font-weight:700;color:var(--text-2);margin-bottom:7px;text-transform:uppercase;letter-spacing:0.6px\">\n                Amount (₹)\n            </label>\n            <input data-kid=\"2-2-4-4\" data-name=\"funding amount input field\" style=\"width:100%;height:46px;padding:0 14px;background:var(--bg);border:1px solid var(--border-strong);color:var(--text);font-size:15px;font-family:inherit;outline:none;margin-bottom:12px\" value=\"500\"/>\n            <div data-kid=\"2-2-4-5\" data-name=\"preset amount buttons container\" style=\"display:flex;gap:8px;margin-bottom:18px\">\n                <button data-kid=\"2-2-4-5-1\" data-name=\"200 funding button\" style=\"flex:1;height:36px;background:var(--surface);border:1px solid var(--border);color:var(--text);font-weight:700;font-size:12px;font-family:inherit;cursor:pointer\">\n                    +₹200\n                </button>\n                <button data-kid=\"2-2-4-5-2\" data-name=\"500 funding button\" style=\"flex:1;height:36px;background:var(--accent-weak);border:1px solid var(--brand);color:var(--accent);font-weight:700;font-size:12px;font-family:inherit;cursor:pointer\">\n                    +₹500\n                </button>\n                <button data-kid=\"2-2-4-5-3\" data-name=\"1000 funding button\" style=\"flex:1;height:36px;background:var(--surface);border:1px solid var(--border);color:var(--text);font-weight:700;font-size:12px;font-family:inherit;cursor:pointer\">\n                    +₹1000\n                </button>\n                <button data-kid=\"2-2-4-5-4\" data-name=\"2000 funding button\" style=\"flex:1;height:36px;background:var(--surface);border:1px solid var(--border);color:var(--text);font-weight:700;font-size:12px;font-family:inherit;cursor:pointer\">\n                    +₹2000\n                </button>\n            </div>\n            <button data-kid=\"2-2-4-6\" data-name=\"execute funding button\" style=\"width:100%;height:48px;background:var(--brand);color:var(--on-brand);border:none;font-size:15px;font-weight:700;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px;cursor:pointer\">\n                <i class=\"ph ph-arrow-circle-down\" data-kid=\"2-2-4-6-1\" data-name=\"fund arrow icon\" style=\"font-size:18px\">\n                </i>\n                <span data-kid=\"2-2-4-6-2\" data-name=\"fund button text\">\n                    Fund via Mock Gateway\n                </span>\n            </button>\n        </div>\n    </main>\n    <nav data-kid=\"2-3\" data-name=\"navigation bar\" style=\"display:flex;align-items:center;justify-content:space-around;padding:10px 10px 12px;border-top:1px solid var(--border);background:var(--surface)\">\n        <div data-kid=\"2-3-1\" data-name=\"home navigation item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--text-3)\">\n            <i class=\"ph ph-house\" data-kid=\"2-3-1-1\" data-name=\"home navigation icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-1-2\" data-name=\"home navigation label\" style=\"font-size:10px;font-weight:700\">\n                Home\n            </span>\n        </div>\n        <div data-kid=\"2-3-2\" data-name=\"wallet navigation item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--accent)\">\n            <i class=\"ph ph-wallet\" data-kid=\"2-3-2-1\" data-name=\"wallet navigation icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-2-2\" data-name=\"wallet navigation label\" style=\"font-size:10px;font-weight:700\">\n                Wallet\n            </span>\n        </div>\n        <div data-kid=\"2-3-3\" data-name=\"qr code action button\" style=\"width:46px;height:46px;background:var(--brand);display:flex;align-items:center;justify-content:center;color:var(--on-brand)\">\n            <i class=\"ph ph-qr-code\" data-kid=\"2-3-3-1\" data-name=\"qr code icon\" style=\"font-size:24px\">\n            </i>\n        </div>\n        <div data-kid=\"2-3-4\" data-name=\"activity navigation item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--text-3)\">\n            <i class=\"ph ph-arrows-left-right\" data-kid=\"2-3-4-1\" data-name=\"activity navigation icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-4-2\" data-name=\"activity navigation label\" style=\"font-size:10px;font-weight:700\">\n                Activity\n            </span>\n        </div>\n        <div data-kid=\"2-3-5\" data-name=\"profile navigation item\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--text-3)\">\n            <i class=\"ph ph-user\" data-kid=\"2-3-5-1\" data-name=\"profile navigation icon\" style=\"font-size:22px\">\n            </i>\n            <span data-kid=\"2-3-5-2\" data-name=\"profile navigation label\" style=\"font-size:10px;font-weight:700\">\n                Profile\n            </span>\n        </div>\n    </nav>\n</div>\n",
